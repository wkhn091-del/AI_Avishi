# Stash server settings: copy this file to server/.env and fill in what you use.
# Values that still look like these examples ("your_groq_key") are ignored, with a
# warning at startup, so a partly filled copy is safe to run.

PORT=4000
NODE_ENV=development

# The AI providers the server may use. A provider needs both a place in this list
# and a key; remove a provider here to switch it off without deleting its key.
AI_PROVIDERS=gemini,groq,openrouter,cohere,huggingface,anthropic,openai,deepseek,moonshot

GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key
OPENROUTER_API_KEY=your_openrouter_key
COHERE_API_KEY=your_cohere_key
HF_API_KEY=your_hf_key
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
DEEPSEEK_API_KEY=your_deepseek_key
MOONSHOT_API_KEY=your_moonshot_key
GITHUB_TOKEN=your_github_token

# --- Accounts and the database (Supabase) ---------------------------------------
# Everyone signs in (Supabase Auth), and each person's conversations and memories are kept
# apart in PostgreSQL. README > "Accounts and the cloud database" walks through the setup.
#
# Supabase > Project Settings > API Keys: the project URL and the publishable key
# (sb_publishable_..., or the legacy anon key). Both are public: the browser signs in with them.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only for projects that still sign tokens with the legacy shared secret (Project Settings >
# JWT Keys). Projects on asymmetric keys (the default) are checked with their public keys,
# which the server fetches from Supabase: leave this empty.
SUPABASE_JWT_SECRET=
# Emails (comma-separated) that may also use the single-person tools: projects, GitHub, links
# and files. Everyone else gets the chat and the media studio.
ADMIN_EMAILS=
#
# Supabase > Connect > Connection string. For a server that stays up: the session pooler
# (port 5432). For serverless hosting: the transaction pooler (port 6543). DIRECT_URL is for
# migrations (npm run db:migrate -w server): the direct connection or the session pooler,
# never the transaction pooler.
DATABASE_URL=
DIRECT_URL=
# Connections the server keeps open (Supabase's plans allow a limited number in total).
DATABASE_POOL_SIZE=5
# To verify the database's certificate: the path of Supabase's CA certificate
# (Database Settings > SSL Configuration). Without it the connection is encrypted but the
# certificate isn't checked.
DATABASE_CA_CERT=

# --- Where the keys come from (September 2026) --------------------------------
# Free workspace (free tiers without a card):
#   Groq          https://console.groq.com/keys             rate-limited
#   OpenRouter    https://openrouter.ai/keys                ":free" models, 50 requests a day
#   Cohere        https://dashboard.cohere.com/api-keys     trial key, 1,000 calls a month
#   Hugging Face  https://huggingface.co/settings/tokens     about $0.10 of credit a month
# Premium workspace (paid, except Gemini's free tier):
#   Anthropic     https://console.anthropic.com/settings/keys  Fable 5.1, Opus 5.5, Sonnet 5, Haiku 4.5
#   OpenAI        https://platform.openai.com/api-keys          GPT-5.5
#   Gemini        https://aistudio.google.com/apikey            Gemini Pro, and Gemini Flash for routing
#   DeepSeek      https://platform.deepseek.com/api_keys        DeepSeek V4 Pro
#   Moonshot      https://platform.kimi.ai/console/api-keys     Kimi K3
# GitHub: a fine-grained token with read-only "Contents" and "Metadata" access
# (a classic token needs the "repo" scope for private repositories). A token
# saved in the app's settings (הגדרות) replaces this one.

# --- Default models ------------------------------------------------------------
# Used by project summaries, file explanations and the free workspace. The premium
# model sheet uses its own models (Opus 5.5 and the rest) and ignores these.
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b
# openrouter/free routes to whichever free model fits, so rotating free models don't break it.
OPENROUTER_MODEL=openrouter/free
COHERE_MODEL=command-a-plus-05-2026
HF_MODEL=openai/gpt-oss-120b:cheapest
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-5.4-mini
DEEPSEEK_MODEL=deepseek-flash
MOONSHOT_MODEL=kimi-k2.6

# --- Chat: routing and memory ------------------------------------------------------
# The premium auto-router rates each request's complexity (1-10) with this model.
ROUTER_MODEL=gemini-flash-latest
# Every N turns the conversation is summarised into project_state.md by a fast model;
# from then on the models get project_state.md plus the last K messages.
CHAT_COMPACT_EVERY=10
CHAT_KEEP_RECENT=3
# An answer cut off by the model's length limit is continued automatically, on the same
# stream, up to this many times (0 turns it off).
AUTO_CONTINUE_MAX=4
# Cost-saving handoff: after the first answer, fixes and follow-ups, and automatic continuations,
# go to a cheap model with a large output (DeepSeek V4.1 Flash, Gemini Flash, GPT mini...).
# Planning and the hardest requests (9-10) keep the chosen model. "off" turns it off.
CHAT_HANDOFF=on
# Development team (the swarm): a coding request rated at least PIPELINE_MIN_COMPLEXITY (1-10)
# at the start of a project is planned by an architect as a JSON blueprint, written file by file
# by micro-agents in parallel, and checked by the QA compiler (parser checks + a reviewer model),
# which sends broken files back up to PIPELINE_QA_ROUNDS times. PIPELINE=off answers with one model.
PIPELINE=on
PIPELINE_MIN_COMPLEXITY=7
# Who takes each role first (catalog ids); a role falls back to the next model with a key.
# The micro-agents alternate between the builder and the first fallback on another provider.
PIPELINE_ARCHITECT=gpt-6-sol
PIPELINE_ARCHITECT_FALLBACK=opus-5.5
PIPELINE_BUILDER=deepseek-flash
PIPELINE_REVIEWER=sonnet-5
# Files written at the same time, the most files one plan may have, each file's output limit
# (tokens; a file cut off there is continued), and the automatic fix rounds.
PIPELINE_CONCURRENCY=8
PIPELINE_MAX_FILES=60
PIPELINE_FILE_TOKENS=8192
PIPELINE_QA_ROUNDS=3

# Sandbox: install, build, test and start every project the development team writes, in isolation, and
# send the real errors back to the micro-agents (up to SANDBOX_ROUNDS times). Off by default.
#   docker  self-hosted, through the docker CLI (podman works too: SANDBOX_DOCKER_CLI=podman). Access to
#           Docker is root on its host: prefer a separate sandbox host (DOCKER_HOST=ssh://user@host),
#           gVisor (SANDBOX_DOCKER_RUNTIME=runsc), and a network that reaches only the npm registry.
#   e2b     hosted Firecracker microVMs (e2b.dev), for hosts without Docker: set E2B_API_KEY.
# Only admins (ADMIN_EMAILS) get it, unless SANDBOX_ACCESS=everyone.
SANDBOX=off
SANDBOX_ACCESS=admins
SANDBOX_ROUNDS=2
SANDBOX_MAX_RUNS=2
# Each step's time limit (install, build, types, tests), and how long a server must stay up, in seconds.
SANDBOX_STEP_SECONDS=300
SANDBOX_START_SECONDS=8
# Live previews: after a run, the sandbox keeps the project's dev server up for the answer's live preview, on an
# origin of its own (s-<token>.localhost), SANDBOX_PREVIEW_MINUTES after it was made, edited or last used, and
# SANDBOX_PREVIEW_MAX_MINUTES at most; SANDBOX_MAX_PREVIEWS at once. off: the sandbox ends with the run.
SANDBOX_PREVIEW=on
SANDBOX_PREVIEW_MINUTES=15
SANDBOX_PREVIEW_MAX_MINUTES=60
SANDBOX_MAX_PREVIEWS=4
SANDBOX_PREVIEW_PORT=5173
SANDBOX_PREVIEW_READY_SECONDS=90
# Docker: the CLI, the image (Node with build tools), memory, CPUs, the network npm install uses, the runtime.
SANDBOX_DOCKER_CLI=docker
SANDBOX_DOCKER_IMAGE=node:22-bookworm
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2
SANDBOX_DOCKER_NETWORK=bridge
SANDBOX_DOCKER_RUNTIME=
# E2B: the key, and a template with Node 20 or newer (empty: E2B's default template).
E2B_API_KEY=
SANDBOX_E2B_TEMPLATE=
# Cost meter: built-in prices (USD per 1M tokens) can be overridden or added as JSON, e.g.
# MODEL_PRICES={"gpt-5.6-sol":{"input":5,"output":30,"cached":0.5}}
MODEL_PRICES=
# Providers whose usage costs you nothing (a free-tier key), comma-separated, e.g. gemini.
COST_FREE_PROVIDERS=
# Web research: when the router finds that a request needs current information (news, the newest version of a
# library or API), Tavily searches the web first and the pages' text goes to the models, with the sources shown.
# Get a key at https://tavily.com (the free plan has 1,000 searches a month). "off" turns it off.
WEB_RESEARCH=on
TAVILY_API_KEY=
# basic (1 credit per search) or advanced (2); results per search (up to 10); minutes a search is reused.
WEB_RESEARCH_DEPTH=basic
WEB_RESEARCH_RESULTS=5
WEB_RESEARCH_CACHE_MINUTES=60
# Long-term memory: what the chat learns about how you work, kept across conversations and given to every model.
# Manage it under "מה למדתי עליך" in the model sheet. "off" turns it off.
LONG_TERM_MEMORY=on
# Semantic search: auto (Gemini, then OpenAI), gemini, openai, or off (memories are matched by their words).
MEMORY_EMBEDDINGS=auto
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# The cheap model that writes down what an answer taught (a catalog id); falls back to other cheap models.
MEMORY_LEARNER=gpt-4o-mini
# Code ZIPs are temporary: deleted after this many hours, rebuilt from the answer on download.
BUNDLE_TTL_HOURS=24
# Chat attachments (premium workspace). Images go to vision models as Base64; a video goes to
# Gemini, inline up to GEMINI_INLINE_MAX_MB and through Gemini's Files API above it.
CHAT_IMAGE_MAX_MB=5
CHAT_VIDEO_MAX_MB=100
GEMINI_INLINE_MAX_MB=14

# --- Project summaries -----------------------------------------------------------
# The primary provider writes file explanations and is the fallback for everything:
# "auto" takes the first configured one (Gemini, Anthropic, OpenAI, Groq, Cohere,
# OpenRouter, Hugging Face, DeepSeek, Kimi). "none" turns AI off.
AI_PROVIDER=auto
# Summaries of ZIP projects and GitHub repositories: "free" asks every configured
# provider with a free tier at once and merges their answers into one Hebrew
# summary; "all" also asks the paid ones; "off" asks only the primary provider;
# or list providers, e.g. gemini,groq,cohere. AI_SYNTHESIZER merges (default: primary).
AI_ENSEMBLE=free
AI_SYNTHESIZER=

# --- Reliability -------------------------------------------------------------------
# Time limit for one request (for the chat: until the answer starts).
AI_TIMEOUT_MS=30000
# Temporary failures (HTTP 429/500/502/503/504, dropped connections) are retried
# after 2 s, 4 s, 8 s... (AI_RETRY_BASE_MS doubling). 0 turns retries off.
AI_MAX_RETRIES=3
AI_RETRY_BASE_MS=2000

# --- Media studio --------------------------------------------------------------------
# Pollinations secret key (sk_...) from https://enter.pollinations.ai/keys (sign up
# with GitHub, no card). Free accounts get a small daily Pollen grant: plenty for
# images from cheap models such as Flux Schnell, but music and video cost far more.
POLLINATIONS_API_KEY=
# Video can take minutes to render.
MEDIA_TIMEOUT_MS=300000

# --- Server -------------------------------------------------------------------
# Loopback by default. When hosting Stash for others, 0.0.0.0 behind HTTPS: every API request
# needs a signed-in account.
HOST=127.0.0.1
# Extra hostnames allowed to reach the server (localhost and IPs always are),
# comma-separated: your domain when hosted (e.g. stash.example.com), or my-pc.local
ALLOWED_HOSTS=

# The browser app's origins when it's hosted apart from this server (the app on Vercel, this API on Render),
# comma-separated; * only inside one part of the host name (https://stash-*-me.vercel.app). Build that app with
# VITE_API_URL set to this server's address.
CORS_ORIGINS=
# Signs the read-only links (12 hours) such an app uses for images, downloads and live updates. A long random
# string; without it, a new key at every start, and those links stop working until the page is reloaded.
RESOURCE_TOKEN_SECRET=
# Where the database, archives and files are kept (relative to server/).
STORAGE_DIR=storage

# --- Upload limits (MB) -------------------------------------------------------
MAX_ZIP_MB=250
MAX_FILE_MB=500

# --- Link previews ------------------------------------------------------------
LINK_FETCH_TIMEOUT_MS=8000
# Fetch previews for localhost / LAN links too (off by default for safety).
ALLOW_PRIVATE_NETWORK_URLS=false

# --- Logging ------------------------------------------------------------------
# One line per API request (method, path, status, duration).
LOG_REQUESTS=true
